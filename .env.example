# Nunca subir el archivo .env a GitHub.
SATIPO_MODE=demo
SUPABASE_URL=
# Clave publica sb_publishable_... (o anon heredada). Nunca service_role aqui.
SUPABASE_PUBLISHABLE_KEY=
# Solo para el script local de importacion. Nunca llega al navegador.
SUPABASE_SECRET_KEY=
# API local opcional: http://127.0.0.1:8787/api
# Si esta vacia se utiliza la funcion admin-api del proyecto Supabase.
SATIPO_API_URL=
