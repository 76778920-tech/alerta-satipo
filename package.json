{
  "name": "alerta-satipo",
  "version": "0.2.0",
  "private": true,
  "description": "Vigilancia comunitaria con Supabase Auth y PostgreSQL",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:hosting": "npm run build && npm run configure && node scripts/prepare-hosting.mjs",
    "configure": "node --env-file-if-exists=.env scripts/configure.mjs",
    "dataset": "python scripts/prepare_dataset.py",
    "import:dataset": "node --env-file-if-exists=.env scripts/import-dataset.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "python scripts/serve.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.2"
  }
}
